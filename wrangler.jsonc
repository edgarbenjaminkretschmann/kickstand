// Cloudflare Workers config for Kickstand. `npm run deploy` builds and uploads; `npm run preview` runs it locally.
// Secrets are not stored here: `wrangler secret put BETTER_AUTH_SECRET`, `DATABASE_AUTH_TOKEN`,
// and optionally `GOOGLE_CLIENT_ID` / `GOOGLE_CLIENT_SECRET` and `BREVO_API_KEY`. For `npm run preview` they go into .dev.vars.
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "kickstand",
  "main": "./dist/_worker.js/index.js",
  "compatibility_date": "2026-10-01",
  "compatibility_flags": ["nodejs_compat"],
  // Static files from the build (dist/), as @astrojs/cloudflare expects. public/.assetsignore keeps _worker.js out.
  "assets": { "binding": "ASSETS", "directory": "./dist" },
  "observability": { "enabled": true },
  // Weekly, Monday 06:00 UTC: keeps the Brevo API key from expiring after 90 idle days (src/worker.ts).
  "triggers": { "crons": ["0 6 * * 1"] },
  // Turso sits in AWS eu-west-1 and one page runs several queries: run the Worker near the database.
  "placement": { "mode": "smart" },
  // Custom domains (zones kickstand.top and deutschacademy.com, same account). Wrangler creates the DNS
  // records and certificates. kickstand.top is the address; www, the former kickstand.deutschacademy.com
  // and the workers.dev address stay on and 301-redirect to it (REDIRECT_HOSTS, src/middleware.ts).
  "routes": [
    { "pattern": "kickstand.top", "custom_domain": true },
    { "pattern": "www.kickstand.top", "custom_domain": true },
    { "pattern": "kickstand.deutschacademy.com", "custom_domain": true }
  ],
  "workers_dev": true,
  "vars": {
    // Turso (libsql://<db>-<org>.aws-eu-west-1.turso.io). The token is the secret DATABASE_AUTH_TOKEN.
    "DATABASE_URL": "libsql://kickstand-kickstand.aws-eu-west-1.turso.io",
    // Public URL. Also read by astro.config.mjs at build time, so it is the one place to change it.
    "SITE_URL": "https://kickstand.top",
    "BETTER_AUTH_URL": "https://kickstand.top",
    // Hosts that 301-redirect to SITE_URL (path and query kept).
    "REDIRECT_HOSTS": "www.kickstand.top,kickstand.deutschacademy.com",
    // Shows the demo accounts on /login. "false" once real members use the site.
    "SHOW_DEMO_LOGINS": "true",
    // PostHog project token (public, write-only; EU project 345772). Empty turns analytics off.
    "POSTHOG_KEY": "phc_orDnbNAhmrhCEhQudHXkLvzXR4kmK6dvCGeo32XFcscb",
    // Sender for password-reset mails (Brevo). The API key is the secret BREVO_API_KEY; without it the
    // "Passwort vergessen" page says resetting is unavailable.
    "MAIL_FROM": "hello@kickstand.top",
    "MAIL_FROM_NAME": "Kickstand"
  },
  // All photos (listings, bikes, loan protocols). Private, no public URL: served only through /media/*,
  // which checks access first.
  "r2_buckets": [{ "binding": "PHOTOS", "bucket_name": "kickstand-photos" }],
  // Resizes uploads and strips their metadata (replaces sharp, which does not run on Workers).
  "images": { "binding": "IMAGES" },
  // Workers Rate Limiting (src/lib/rate-limit.ts). Periods can only be 10 or 60 seconds.
  "ratelimits": [
    { "name": "LOGIN_IP_LIMITER", "namespace_id": "1001", "simple": { "limit": 20, "period": 60 } },
    { "name": "LOGIN_EMAIL_LIMITER", "namespace_id": "1002", "simple": { "limit": 5, "period": 60 } },
    { "name": "MESSAGE_LIMITER", "namespace_id": "1003", "simple": { "limit": 10, "period": 60 } }
  ]
}
