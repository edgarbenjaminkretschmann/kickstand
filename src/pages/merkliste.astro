---
import { actions } from "astro:actions";
import Base from "../layouts/Base.astro";
import ListingCard from "../components/ListingCard.astro";
import { i18n } from "../i18n";
import { listSaved } from "../lib/data/saved";

const { t } = i18n(Astro.locals.lang);
const user = Astro.locals.user!;
const removed = Astro.getActionResult(actions.listings.save);
if (removed && !removed.error) return Astro.redirect("/merkliste");
const saved = await listSaved(user.id);
---

<Base title={t("Merkliste")} wide>
  <div class="page-head">
    <h1>{t("Merkliste")}</h1>
    <p>{t("Anzeigen, die du dir gemerkt hast.")}</p>
  </div>
  {
    saved.length === 0 ? (
      <div class="empty-box">
        <p>{t("Noch nichts gemerkt. Tipp bei einer Anzeige auf „Merken“.")}</p>
        <a class="btn" href="/anzeigen">
          {t("Anzeigen ansehen")}
        </a>
      </div>
    ) : (
      <div class="cards">
        {saved.map((l) => (
          <div class="saved-item">
            <ListingCard listing={l} showStatus headingLevel={2} />
            <form method="POST" action={actions.listings.save}>
              <input type="hidden" name="listingId" value={l.id} />
              <input type="hidden" name="saved" value="0" />
              <button type="submit" class="btn-link">
                {t("Von der Merkliste nehmen")}
              </button>
            </form>
          </div>
        ))}
      </div>
    )
  }
</Base>
