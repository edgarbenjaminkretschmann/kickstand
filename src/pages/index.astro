---
// Start page: search first, categories, the newest listings, the contract generator, how it works, Benno's
// safety tips, and a call to post.
import { actions } from "astro:actions";
import Base from "../layouts/Base.astro";
import Benno from "../components/benno/Benno.astro";
import BennoWave from "../components/benno/BennoWave.astro";
import CategoryIcon from "../components/CategoryIcon.astro";
import ListingCard from "../components/ListingCard.astro";
import { latestListings, listCategories } from "../lib/data/listings";
import { savedIds } from "../lib/data/saved";
import { i18n } from "../i18n";

const { t } = i18n(Astro.locals.lang);
const loggedOut = Astro.getActionResult(actions.auth.logout);
if (loggedOut && !loggedOut.error) return Astro.redirect("/");
const user = Astro.locals.user;
const [categories, latest] = await Promise.all([listCategories(), latestListings(8)]);
const saved = user ? await savedIds(user.id, latest.map((l) => l.id)) : null;
const heartFor = (id: string, owner: string) => (!user ? ("login" as const) : owner === user.id ? undefined : saved!.has(id));

// Pre-filled searches. Categories and single words, so each one finds something.
const popular = [
  { href: "/anzeigen?kategorie=garage", label: t("Garage / Stellplatz") },
  { href: "/anzeigen?q=Hebebühne", label: t("Hebebühne") },
  { href: "/anzeigen?kategorie=motorrad-leihen", label: t("Motorrad zum Leihen") },
  { href: "/anzeigen?kategorie=hilfe", label: t("Hilfe beim Schrauben") },
];
const CHECK = "M5 12l5 5L19 7";
---

<Base bare>
  <section class="hero-band">
    <div class="wrap wide hero">
      <div class="hero-text">
        <p class="eyebrow">{t("Kostenlos · privat · in deiner Nähe")}</p>
        <h1>{t("Garage, Werkzeug, Hilfe. Von Fahrern nebenan.")}</h1>
        <p class="lead">
          {t("Biete und suche alles, was Motorradfahrer brauchen: ein Bike zum Leihen, einen Stellplatz, den passenden Schlüssel oder jemanden, der mitschraubt.")}
        </p>
        <form method="GET" action="/anzeigen" class="bigsearch" role="search">
          <label class="bs-q">
            <svg width="22" height="22" viewBox="0 0 24 24" aria-hidden="true"><circle cx="11" cy="11" r="7"></circle><path d="M20 20l-3.5-3.5"></path></svg>
            <span class="visually-hidden">{t("Was suchst du?")}</span>
            <input type="search" name="q" placeholder={t("Was suchst du? z. B. Hebebühne")} enterkeyhint="search" />
          </label>
          <label class="bs-ort">
            <svg width="20" height="20" viewBox="0 0 24 24" aria-hidden="true"><path d="M12 21s-6-5.6-6-11a6 6 0 0 1 12 0c0 5.4-6 11-6 11z"></path><circle cx="12" cy="10" r="2.5"></circle></svg>
            <span class="visually-hidden">{t("PLZ oder Ort")}</span>
            <input type="search" name="ort" placeholder={t("PLZ oder Ort")} autocomplete="address-level2" enterkeyhint="search" />
          </label>
          <button type="submit" class="btn-primary">{t("Finden")}</button>
        </form>
        <p class="popular">
          <span>{t("Beliebt:")}</span>
          {popular.map((p) => <a href={p.href}>{p.label}</a>)}
        </p>
      </div>
      <div class="hero-benno">
        <p class="bubble">{t("Ich hab da was für dich.")}</p>
        <Benno size={320} label={t("Benno, der Biber mit Motorradbrille und Schraubenschlüssel")} />
      </div>
    </div>
  </section>

  <section class="wrap wide section" aria-labelledby="h-kat">
    <h2 id="h-kat" class="h-section">{t("Kategorien")}</h2>
    <ul class="cats">
      {
        categories.map((c) => (
          <li>
            <a href={`/anzeigen?kategorie=${c.slug}`} class="cat">
              <span class="cat-tile">
                <CategoryIcon slug={c.slug} size={26} />
              </span>
              <span class="cat-label">{t(c.label)}</span>
            </a>
          </li>
        ))
      }
    </ul>
  </section>

  <section class="wrap wide section" aria-labelledby="h-neu">
    <div class="section-head">
      <h2 id="h-neu" class="h-section">{t("Neueste Anzeigen")}</h2>
      <a href="/anzeigen" class="more">{t("Alle Anzeigen ansehen")}</a>
    </div>
    {
      latest.length ? (
        <div class="cards">
          {latest.map((l) => (
            <ListingCard listing={l} heart={heartFor(l.id, l.userId)} />
          ))}
        </div>
      ) : (
        <div class="empty-box">
          <BennoWave size={120} />
          <p>{t("Noch keine Anzeigen. Biete deine Garage an, verleih Werkzeug oder frag nach Hilfe.")}</p>
          <a class="btn btn-primary" href="/anzeigen/neu">
            {t("Erste Anzeige aufgeben")}
          </a>
        </div>
      )
    }
  </section>

  <section class="wrap wide section-tight" aria-labelledby="h-vertrag">
    <div class="contract-band">
      <div class="contract-text">
        <span class="chip chip-suche">{t("Ohne Anmeldung")}</span>
        <h2 id="h-vertrag">{t("Motorrad verleihen? Mit Vertrag.")}</h2>
        <p class="contract-lead">
          {t("Leihvertrag nach BGB, Übergabeprotokoll mit Fotos und Unterschrift auf dem Handy. In fünf Minuten als PDF, deine Daten bleiben auf deinem Gerät.")}
        </p>
        <ul class="checks">
          <li><svg width="22" height="22" viewBox="0 0 24 24" aria-hidden="true"><path d={CHECK}></path></svg>{t("Offen oder festes Ende")}</li>
          <li><svg width="22" height="22" viewBox="0 0 24 24" aria-hidden="true"><path d={CHECK}></path></svg>{t("Haftungsgrenze frei wählbar")}</li>
          <li><svg width="22" height="22" viewBox="0 0 24 24" aria-hidden="true"><path d={CHECK}></path></svg>{t("Fotos und Unterschrift im Protokoll")}</li>
        </ul>
        <a class="btn btn-xl btn-white" href="/leihvertrag">{t("Leihvertrag erstellen")}</a>
      </div>
      {/* A quote from the contract, which is German only (binding text). */}
      <div class="mini-contract" lang="de" aria-hidden="true">
        <p class="mc-title">Leihvertrag über ein Motorrad</p>
        <p class="mc-sub">unentgeltliche Leihe gemäß §§ 598 ff. BGB</p>
        <p class="mc-head">§ 6 Haftung des Entleihers</p>
        <p class="mc-text">(2) Die Haftung ist auf höchstens <strong>1.000,00 €</strong> je Schadensfall begrenzt.</p>
        <div class="mc-sign"><span>Verleiher</span><span>Entleiher</span></div>
      </div>
    </div>
  </section>

  <section id="so" class="wrap wide section" aria-labelledby="h-so">
    <h2 id="h-so" class="h-section">{t("So geht's")}</h2>
    <ol class="steps">
      <li class="step">
        <span class="step-num" aria-hidden="true">1</span>
        <h3>{t("Anzeige aufgeben")}</h3>
        <p>{t("Biete deinen Stellplatz, dein Werkzeug oder dein Bike an. Oder schreib, was du suchst. Dauert zwei Minuten.")}</p>
      </li>
      <li class="step">
        <span class="step-num" aria-hidden="true">2</span>
        <h3>{t("Nachricht schreiben")}</h3>
        <p>{t("Klärt alles im Chat auf Kickstand. Deine Telefonnummer und E-Mail bleiben privat.")}</p>
      </li>
      <li class="step">
        <span class="step-num" aria-hidden="true">3</span>
        <h3>{t("Treffen und loslegen")}</h3>
        <p>{t("Bei einem Motorrad startest du den Leihvertrag direkt aus dem Chat, mit Protokoll und Fotos.")}</p>
      </li>
    </ol>
  </section>

  <section id="sicherheit" class="wrap wide section-tight" aria-labelledby="h-sicher">
    <div class="safety-band">
      <BennoWave size={140} />
      <div class="safety-text">
        <h2 id="h-sicher" class="h-section">{t("Bennos Sicherheitstipps")}</h2>
        <ul class="tips">
          <li><strong>{t("Öffentlich treffen.")}</strong> {t("Erste Übergabe am Tag und an einem belebten Ort.")}</li>
          <li><strong>{t("Führerschein zeigen.")}</strong> {t("Klasse A prüfen, bevor jemand losfährt.")}</li>
          <li><strong>{t("Alles festhalten.")}</strong> {t("Kilometer, Tank, Kratzer: mit Fotos ins Protokoll.")}</li>
          <li><strong>{t("Im Chat bleiben.")}</strong> {t("Keine Vorkasse und keine fremden Links.")}</li>
        </ul>
      </div>
    </div>
  </section>

  <section class="wrap wide section-tight cta-wrap">
    <div class="cta-band">
      <div class="cta-text">
        <h2>{t("Was liegt bei dir in der Garage rum?")}</h2>
        <p>{t("Ein freier Stellplatz, ein Satz Koffer, ein Abzieher. Irgendwer in deiner Nähe sucht genau das.")}</p>
      </div>
      <a class="btn btn-dark btn-xl" href="/anzeigen/neu">{t("Anzeige aufgeben")}</a>
    </div>
  </section>
</Base>

<style>
  .section {
    padding-top: 40px;
    padding-bottom: 8px;
    display: flex;
    flex-direction: column;
    gap: 16px;
  }
  .section-tight {
    padding-top: 32px;
  }
  .cta-wrap {
    padding-bottom: 56px;
  }
  .h-section {
    font-size: clamp(1.5rem, 1.1rem + 1.6vw, 2.25rem);
  }
  .section-head {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    justify-content: space-between;
    gap: 4px 16px;
  }
  .more {
    font-weight: 600;
    display: inline-flex;
    align-items: center;
    min-height: var(--tap);
  }

  /* Hero */
  .hero-band {
    background: var(--card);
    border-bottom: 1px solid var(--line);
  }
  .hero {
    padding-top: 48px;
    padding-bottom: 40px;
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 24px 40px;
  }
  .hero-text {
    flex: 999 1 540px;
    min-width: 0;
    display: flex;
    flex-direction: column;
    gap: 18px;
  }
  .eyebrow {
    font-weight: 600;
    color: var(--petrol);
    font-size: 15px;
  }
  .hero h1 {
    font-size: clamp(2.25rem, 1.2rem + 4.2vw, 3.75rem);
    line-height: 1.02;
    letter-spacing: -0.02em;
    max-width: 14ch;
  }
  .lead {
    font-size: clamp(1.05rem, 1rem + 0.3vw, 1.2rem);
    color: var(--text-2);
    max-width: 52ch;
  }
  .bigsearch {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    border: 2px solid var(--ink);
    border-radius: 20px;
    padding: 8px;
    max-width: 760px;
    background: var(--card);
  }
  .bigsearch label {
    display: flex;
    align-items: center;
    gap: 10px;
    padding: 0 8px 0 12px;
    min-height: 52px;
    min-width: 0;
    color: var(--muted);
  }
  .bs-q {
    flex: 3 1 240px;
  }
  .bs-ort {
    flex: 1 1 160px;
    border-left: 1px solid var(--line);
  }
  .bigsearch svg {
    flex: none;
    fill: none;
    stroke: currentColor;
    stroke-width: 2;
    stroke-linecap: round;
    stroke-linejoin: round;
  }
  .bigsearch input[type="search"] {
    border: 0;
    padding: 0;
    min-height: 48px;
    font-size: 17px;
    background: transparent;
    border-radius: 0;
  }
  .bigsearch input:focus-visible {
    outline: none;
  }
  .bigsearch:focus-within {
    outline: 3px solid var(--petrol);
    outline-offset: 2px;
  }
  .bigsearch button {
    flex: 0 0 auto;
    min-height: 52px;
    padding: 0 28px;
    border-radius: 14px;
    font-size: 17px;
  }
  /* Phones: the place field moves below the keyword, the button fills the row. */
  @media (max-width: 559px) {
    .bs-ort {
      border-left: 0;
      border-top: 1px solid var(--line);
    }
    .bigsearch button {
      flex: 1 1 100%;
    }
  }
  .popular {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0 14px;
    font-size: 15px;
    color: var(--muted);
  }
  .popular a {
    display: inline-flex;
    align-items: center;
    min-height: var(--tap);
    font-weight: 600;
  }
  .hero-benno {
    flex: 1 1 280px;
    position: relative;
    display: flex;
    justify-content: center;
  }
  .hero-benno :global(.benno) {
    width: min(320px, 70vw);
    height: auto;
  }
  .bubble {
    position: absolute;
    top: 4px;
    right: max(0px, calc(50% - 180px));
    background: var(--ink);
    color: var(--on-dark);
    font-weight: 600;
    font-size: 15px;
    padding: 10px 14px;
    border-radius: 16px 16px 16px 4px;
    max-width: 200px;
    /* Pops out of Benno's mouth: the origin sits on the mouth (SVG 100,95 of 200),
       measured from the bubble's top-left corner. */
    transform-origin: 40px 148px;
    animation: bubble-pop 0.6s cubic-bezier(0.34, 1.56, 0.64, 1) 0.4s both;
  }
  @keyframes bubble-pop {
    0% {
      opacity: 0;
      transform: scale(0.05);
    }
    35% {
      opacity: 1;
    }
    100% {
      opacity: 1;
      transform: scale(1);
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .bubble {
      animation: none;
    }
  }
  @media (max-width: 559px) {
    .hero {
      padding-top: 28px;
    }
    .hero-benno :global(.benno) {
      width: 180px;
    }
    .bubble {
      font-size: 14px;
      right: calc(50% - 170px);
      transform-origin: 30px 82px;
    }
  }

  /* Categories */
  .cats {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(150px, 1fr));
    gap: 12px;
  }
  .cat {
    display: flex;
    flex-direction: column;
    gap: 12px;
    padding: 18px 16px;
    min-height: 116px;
    height: 100%;
    background: var(--card);
    border: 1px solid var(--line);
    border-radius: var(--radius-card);
    color: var(--ink);
    text-decoration: none;
  }
  .cat:hover {
    border-color: var(--petrol);
    color: var(--ink);
  }
  .cat-tile {
    width: 48px;
    height: 48px;
    border-radius: 14px;
    background: var(--petrol-wash);
    color: var(--petrol);
    display: grid;
    place-items: center;
  }
  .cat-label {
    font-weight: 700;
    line-height: 1.25;
  }
  @media (max-width: 559px) {
    .cats {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: 10px;
    }
    .cat {
      min-height: 0;
      flex-direction: row;
      align-items: center;
      padding: 12px;
      gap: 10px;
    }
    .cat-tile {
      flex: none;
      width: 40px;
      height: 40px;
      border-radius: 12px;
    }
    .cat-label {
      font-size: 14px;
    }
  }

  /* Leihvertrag band */
  .contract-band {
    background: var(--ink);
    color: var(--on-dark);
    border-radius: var(--radius-section);
    padding: clamp(28px, 4vw, 48px) clamp(20px, 4vw, 40px);
    display: flex;
    flex-wrap: wrap;
    gap: 40px;
    align-items: center;
  }
  .contract-text {
    flex: 999 1 420px;
    min-width: 0;
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 16px;
  }
  .contract-text h2 {
    font-size: clamp(1.9rem, 1.2rem + 2.4vw, 2.75rem);
    line-height: 1.05;
    color: var(--on-dark);
  }
  .contract-lead {
    font-size: 1.1rem;
    color: var(--on-dark-muted);
    max-width: 50ch;
  }
  .checks {
    list-style: none;
    margin: 0 0 8px;
    padding: 0;
    display: grid;
    gap: 10px;
  }
  .checks li {
    display: flex;
    align-items: center;
    gap: 10px;
  }
  .checks svg {
    flex: none;
    fill: none;
    stroke: var(--amber);
    stroke-width: 2.5;
    stroke-linecap: round;
    stroke-linejoin: round;
  }
  .btn-white {
    background: var(--card);
    border-color: var(--card);
    color: var(--ink);
    font-weight: 700;
  }
  .btn-white:hover {
    background: var(--petrol-wash);
    border-color: var(--petrol-wash);
  }
  .mini-contract {
    flex: 1 1 300px;
    max-width: 380px;
    margin: 0 auto;
    background: var(--card);
    color: var(--ink);
    border-radius: var(--radius-card);
    padding: 24px;
    transform: rotate(2deg);
  }
  .mc-title {
    font-family: var(--display);
    font-weight: 800;
    font-size: 18px;
  }
  .mc-sub {
    font-size: 13px;
    color: var(--muted);
    margin: 2px 0 16px;
  }
  .mc-head {
    font-weight: 700;
    font-size: 14px;
    margin-bottom: 6px;
  }
  .mc-text {
    font-size: 14px;
    color: var(--text-2);
    margin-bottom: 16px;
  }
  .mc-text strong {
    background: var(--amber-wash);
    color: var(--ink);
    padding: 0 4px;
    border-radius: 4px;
  }
  .mc-sign {
    display: flex;
    gap: 12px;
  }
  .mc-sign span {
    flex: 1;
    border-top: 1.5px solid var(--ink);
    padding-top: 6px;
    font-size: 12px;
    color: var(--muted);
  }

  /* So geht's */
  .steps {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 260px), 1fr));
    gap: 16px;
  }
  .step {
    background: var(--card);
    border: 1px solid var(--line);
    border-radius: var(--radius-card);
    padding: 24px;
    display: flex;
    flex-direction: column;
    gap: 6px;
  }
  .step-num {
    font-family: var(--display);
    font-weight: 800;
    font-size: 44px;
    line-height: 1;
    color: var(--petrol);
    margin-bottom: 6px;
  }
  .step h3 {
    font-size: 20px;
  }
  .step p {
    color: var(--text-2);
  }

  /* Safety */
  .safety-band {
    background: var(--petrol-wash);
    border-radius: var(--radius-section);
    padding: clamp(24px, 4vw, 40px);
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 16px 32px;
  }
  .safety-band > :global(.benno) {
    flex: none;
  }
  .safety-text {
    flex: 999 1 400px;
    min-width: 0;
    display: flex;
    flex-direction: column;
    gap: 16px;
  }
  .tips {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 220px), 1fr));
    gap: 12px 24px;
    color: var(--text-2);
  }
  .tips strong {
    color: var(--ink);
  }

  /* CTA */
  .cta-band {
    background: var(--amber);
    border-radius: var(--radius-section);
    padding: clamp(24px, 4vw, 40px);
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 24px;
  }
  .cta-text {
    flex: 1 1 420px;
    min-width: 0;
    display: flex;
    flex-direction: column;
    gap: 10px;
  }
  .cta-text h2 {
    font-size: clamp(1.75rem, 1.2rem + 2vw, 2.4rem);
    line-height: 1.05;
  }
  .cta-text p {
    font-size: 1.1rem;
  }
</style>
