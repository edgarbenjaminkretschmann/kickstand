---
// Opened from the reset mail: /passwort-neu?token=…  Sets a new password, then sends the member to /login.
import { actions } from "astro:actions";
import Base from "../layouts/Base.astro";
import Field from "../components/Field.astro";
import FormAlert from "../components/FormAlert.astro";
import { i18n, tk } from "../i18n";
import { fieldErrors, formError } from "../lib/form";

const { t } = i18n(Astro.locals.lang);
const result = Astro.getActionResult(actions.auth.resetPassword);
if (result && !result.error) return Astro.redirect("/login?passwort=neu");

const token = Astro.url.searchParams.get("token") ?? "";
const errors = fieldErrors(result);
const message = formError(result) ?? errors.token ?? (token ? null : tk("Der Link ist unvollständig."));
---

<Base title={t("Neues Passwort")}>
  <div class="auth">
    <div class="page-head">
      <h1>{t("Neues Passwort")}</h1>
    </div>
    <div class="card">
      <FormAlert message={message} />
      {
        token ? (
          <form method="POST" action={`${actions.auth.resetPassword}&token=${encodeURIComponent(token)}`} class="stack" novalidate>
            <input type="hidden" name="token" value={token} />
            <Field
              label={t("Neues Passwort")}
              name="password"
              type="password"
              autocomplete="new-password"
              minlength={8}
              required
              hint={t("Mindestens 8 Zeichen.")}
              error={errors.password}
            />
            <button type="submit" class="btn-primary btn-block">{t("Passwort speichern")}</button>
          </form>
        ) : null
      }
      <p class="small"><a href="/passwort-vergessen">{t("Neuen Link anfordern")}</a></p>
    </div>
  </div>
</Base>
