---
import { getEntry, render } from "astro:content";
import Base from "../layouts/Base.astro";
import { i18n } from "../i18n";

const { t, lang } = i18n(Astro.locals.lang);
// Translated text lives in src/content/pages/so-gehts-<lang>.md; German (so-gehts.md) is the fallback.
const entry = (lang !== "de" ? await getEntry("pages", `so-gehts-${lang}`) : undefined) ?? (await getEntry("pages", "so-gehts"));
if (!entry) return new Response(t("Nicht gefunden"), { status: 404 });
const { Content } = await render(entry);
---

<Base title={entry.data.title} description={entry.data.description}>
  <article class="prose">
    <h1>{entry.data.title}</h1>
    <Content />
  </article>
  <p class="actions">
    <a class="btn btn-primary" href={Astro.locals.user ? "/anzeigen?kategorie=motorrad-leihen" : "/registrieren"}>{Astro.locals.user ? t("Motorräder ansehen") : t("Mitmachen")}</a>
  </p>
</Base>

<style>
  .prose {
    display: flex;
    flex-direction: column;
    gap: 12px;
    max-width: 62ch;
  }
  .prose :global(h2) {
    margin-top: 16px;
    font-size: 1.15rem;
  }
  .prose :global(ul),
  .prose :global(ol) {
    margin: 0;
    padding-left: 1.3em;
    display: flex;
    flex-direction: column;
    gap: 4px;
  }
</style>
