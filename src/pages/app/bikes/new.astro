---
import { actions } from "astro:actions";
import { i18n } from "../../../i18n";
import Base from "../../../layouts/Base.astro";
import BikeForm from "../../../components/BikeForm.astro";
import { fieldErrors, formError } from "../../../lib/form";
import { submittedValues } from "../../../lib/submitted";

const { t } = i18n(Astro.locals.lang);
const result = Astro.getActionResult(actions.bikes.save);
if (result && !result.error) return Astro.redirect(`/app?motorrad=${result.data.id}#motorraeder`);

const prev = await submittedValues(Astro.request, !!result?.error);
const values = prev ?? { liabilityCapEur: 1000, fuel: "Benzin" };
---

<Base title={t("Motorrad eintragen")}>
  <div class="page-head">
    <h1>{t("Motorrad eintragen")}</h1>
    <p>{t("Einmal eintragen, dann ist jeder Leihvertrag in ein paar Minuten fertig.")}</p>
  </div>
  <BikeForm values={values} errors={fieldErrors(result)} message={formError(result)} />
</Base>
