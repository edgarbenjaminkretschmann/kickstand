---
import { actions } from "astro:actions";
import Base from "../../../../layouts/Base.astro";
import BikeDoc from "../../../../components/BikeDoc.astro";
import DateField from "../../../../components/DateField.astro";
import Field from "../../../../components/Field.astro";
import FormAlert from "../../../../components/FormAlert.astro";
import TimeField from "../../../../components/TimeField.astro";
import { getLoanForUser } from "../../../../lib/access";
import { loadLoanParts } from "../../../../lib/contract-data";
import { berlinTime, formatDateTime, formatTimestamp, todayIso } from "../../../../lib/dates";
import { groupThousands } from "../../../../lib/euro-words";
import { fieldErrors, formError } from "../../../../lib/form";
import { submittedValues } from "../../../../lib/submitted";
import { photoUrl } from "../../../../lib/urls";
import { i18n } from "../../../../i18n";

const { t, lang } = i18n(Astro.locals.lang);
const user = Astro.locals.user!;
const access = await getLoanForUser(Astro.params.id!, user.id);
if (!access || access.role !== "lender") return new Response(t("Nicht gefunden"), { status: 404 });
const result = Astro.getActionResult(actions.loans.saveReturn);
if (result && !result.error) return Astro.redirect(`/app/loans/${access.loan.id}?zurueck=1`);
if (access.loan.status !== "active") return Astro.redirect(`/app/loans/${access.loan.id}`);

const parts = (await loadLoanParts(access.loan.id))!;
const { loan, bike, handover, ret, returnPhotos } = parts;
const now = new Date();
const prev = await submittedValues(Astro.request, !!result?.error);
const v = prev ?? {
  returnDate: ret?.datetime?.slice(0, 10) ?? todayIso(now),
  returnTime: ret?.datetime?.slice(11, 16) ?? berlinTime(now),
  odometerKm: ret?.odometerKm != null ? String(ret.odometerKm) : "",
  fuelLevel: ret?.fuelLevel ?? "",
  damages: ret?.damages ?? "",
};
const errors = fieldErrors(result);
// Action messages are German keys; translate them where they are shown.
const savedError = formError(result);
---

<Base title={t("Rückgabe")} dock>
  <div class="page-head">
    <h1>{t("Rückgabe")}</h1>
    <p>{t("{bike}, verliehen an {name}", { bike: `${bike.make} ${bike.model}`, name: loan.borrowerName })}</p>
  </div>

  <BikeDoc bike={bike} />

  <section class="card">
    <h2>{t("Bei Übergabe")}</h2>
    <p class="small">
      {formatDateTime(handover?.datetime, null, lang) || "–"} · <span class="mono">{handover?.odometerKm != null ? `${groupThousands(handover.odometerKm)} km` : "km –"}</span> · {t("Tank")} {handover?.fuelLevel || "–"}
    </p>
    {handover?.damages && <p class="small muted">{t("Schäden: {text}", { text: handover.damages })}</p>}
  </section>

  <form id="return-form" method="POST" action={actions.loans.saveReturn} enctype="multipart/form-data" class="stack" novalidate data-loan={loan.id}>
    <input type="hidden" name="loanId" value={loan.id} />
    <FormAlert message={savedError && t(savedError)} />
    <section class="card">
      <h2>{t("Rückgabeprotokoll")}</h2>
      <div class="row">
        <DateField label={t("Datum")} name="returnDate" value={v.returnDate} error={errors.returnDate} required />
        <TimeField label={t("Uhrzeit")} name="returnTime" value={v.returnTime} error={errors.returnTime} />
      </div>
      <div class="row">
        <Field label={t("Kilometerstand")} name="odometerKm" mono inputmode="numeric" value={v.odometerKm} error={errors.odometerKm} />
        <Field label={t("Tankstand")} name="fuelLevel" placeholder={t("z. B. voll, ½")} value={v.fuelLevel} />
      </div>
      <Field label={t("Neue Schäden")} name="damages" multiline value={v.damages} placeholder={t("Leer lassen, wenn nichts Neues dazugekommen ist")} />
      <p class="hint">{t("Tipp: Mit der Mikrofon-Taste auf der Handy-Tastatur kannst du den Text diktieren.")}</p>
      <div class="thumbs" id="thumbs-return">
        {
          returnPhotos.map((p, i) => (
            <div class="thumb" data-photo-id={p.id}>
              <img src={photoUrl(p.id)} alt={t("Foto {n}, {time}", { n: i + 1, time: formatTimestamp(p.takenAt, lang) })} loading="lazy" />
            </div>
          ))
        }
      </div>
      <label class="photo-btn">
        {t("+ Fotos aufnehmen oder hochladen")}
        <input type="file" name="photos" accept="image/*" multiple id="file-return" />
      </label>
    </section>
    <p id="status" role="status" aria-live="polite" class="small muted"></p>
    <p class="hint">{t("Mit dem Speichern ist die Leihe beendet und das Motorrad wieder frei.")}</p>

    <div class="dock">
      <div class="in">
        <a class="btn" href={`/app/loans/${loan.id}`}>{t("Abbrechen")}</a>
        <button type="submit" class="btn-primary">{t("Rückgabe speichern")}</button>
      </div>
    </div>
  </form>
</Base>

<style>
  #status:empty {
    display: none;
  }
  #status.err {
    color: var(--danger);
  }
</style>

<script>
  import { wirePhotoInput } from "../../../../scripts/photos";

  const form = document.getElementById("return-form") as HTMLFormElement | null;
  if (form) {
    const statusEl = document.getElementById("status")!;
    wirePhotoInput({
      input: document.getElementById("file-return") as HTMLInputElement,
      box: document.getElementById("thumbs-return")!,
      kind: "return",
      getLoanId: async () => form.dataset.loan ?? null,
      status: (t, err = false) => {
        statusEl.textContent = t;
        statusEl.classList.toggle("err", err);
      },
    });
  }
</script>
