---
import Base from "../../layouts/Base.astro";
import ListingCard from "../../components/ListingCard.astro";
import { listCategories, searchListings } from "../../lib/data/listings";
import { i18n } from "../../i18n";

const { t } = i18n(Astro.locals.lang);

const q = Astro.url.searchParams;
const filters = {
  q: (q.get("q") ?? "").trim().slice(0, 100),
  type: ["biete", "suche"].includes(q.get("typ") ?? "") ? q.get("typ")! : "",
  category: q.get("kategorie") ?? "",
  ort: (q.get("ort") ?? "").trim().slice(0, 80),
  page: Number(q.get("seite")) || 1,
};
const categories = await listCategories();
if (filters.category && !categories.some((c) => c.slug === filters.category)) filters.category = "";
const result = await searchListings(filters);
const activeCategory = categories.find((c) => c.slug === filters.category);
const filtered = !!(filters.q || filters.type || filters.category || filters.ort);

/** Same filters, other page. */
const pageHref = (page: number) => {
  const p = new URLSearchParams();
  if (filters.q) p.set("q", filters.q);
  if (filters.type) p.set("typ", filters.type);
  if (filters.category) p.set("kategorie", filters.category);
  if (filters.ort) p.set("ort", filters.ort);
  if (page > 1) p.set("seite", String(page));
  const s = p.toString();
  return `/anzeigen${s ? `?${s}` : ""}`;
};
const title = activeCategory ? t(activeCategory.label) : t("Anzeigen");
---

<Base title={title} description={t("Motorräder zum Leihen, Garagen, Werkzeug, Teile, Hilfe beim Schrauben und Tourpartner. Biete und suche unter Motorradfahrern.")} wide>
  <div class="page-head">
    <h1>{title}</h1>
    <p>{t("Biete und suche unter Motorradfahrern: Motorräder zum Leihen, Garagen, Werkzeug, Teile, Hilfe und Touren.")}</p>
  </div>

  <form method="GET" action="/anzeigen" class="search" role="search">
    <label class="field search-q">
      <span class="visually-hidden">{t("Suchbegriff")}</span>
      <input type="search" name="q" value={filters.q} placeholder={t("Was suchst du? z. B. Hebebühne")} enterkeyhint="search" />
    </label>
    <div class="seg seg-3" role="radiogroup" aria-label={t("Art")}>
      <label><input type="radio" name="typ" value="" checked={!filters.type} /><span>{t("Alle")}</span></label>
      <label><input type="radio" name="typ" value="biete" checked={filters.type === "biete"} /><span>{t("Biete")}</span></label>
      <label><input type="radio" name="typ" value="suche" checked={filters.type === "suche"} /><span>{t("Suche")}</span></label>
    </div>
    <div class="row stack-sm">
      <label class="field">
        {t("Kategorie")}
        <select name="kategorie">
          <option value="">{t("Alle Kategorien")}</option>
          {
            categories.map((c) => (
              <option value={c.slug} selected={c.slug === filters.category}>
                {t(c.label)}
              </option>
            ))
          }
        </select>
      </label>
      <label class="field">
        {t("Ort oder PLZ")}
        <input type="search" name="ort" value={filters.ort} placeholder={t("z. B. Leipzig oder 04")} autocomplete="address-level2" />
      </label>
    </div>
    <div class="actions">
      <button type="submit" class="btn-primary">{t("Suchen")}</button>
      {filtered && <a href="/anzeigen" class="btn-link">{t("Filter zurücksetzen")}</a>}
    </div>
  </form>

  <p class="result-count" role="status">
    {result.total === 0 ? t("Keine Anzeigen gefunden.") : result.total === 1 ? t("1 Anzeige") : t("{n} Anzeigen", { n: result.total })}
    {result.pageCount > 1 && <span class="muted"> · {t("Seite {page} von {count}", { page: result.page, count: result.pageCount })}</span>}
  </p>

  {
    result.total === 0 ? (
      <div class="empty-box">
        <p>{filtered ? t("Mit diesen Filtern gibt es gerade nichts. Versuch es mit weniger Filtern.") : t("Noch keine Anzeigen. Sei die oder der Erste.")}</p>
        <a class="btn" href="/anzeigen/neu">
          {t("Anzeige aufgeben")}
        </a>
      </div>
    ) : (
      <div class="cards">
        {result.items.map((l) => (
          <ListingCard listing={l} headingLevel={2} />
        ))}
      </div>
    )
  }

  {
    result.pageCount > 1 && (
      <nav class="pager" aria-label={t("Seiten")}>
        {result.page > 1 ? (
          <a class="btn" href={pageHref(result.page - 1)} rel="prev">
            {t("Zurück")}
          </a>
        ) : (
          <span />
        )}
        <span class="muted small">
          {t("Seite {page} von {count}", { page: result.page, count: result.pageCount })}
        </span>
        {result.page < result.pageCount ? (
          <a class="btn" href={pageHref(result.page + 1)} rel="next">
            {t("Weiter")}
          </a>
        ) : (
          <span />
        )}
      </nav>
    )
  }
</Base>
