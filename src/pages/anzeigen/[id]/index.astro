---
import { actions } from "astro:actions";
import Base from "../../../layouts/Base.astro";
import BennoMark from "../../../components/benno/BennoMark.astro";
import CategoryIcon from "../../../components/CategoryIcon.astro";
import Field from "../../../components/Field.astro";
import FormAlert from "../../../components/FormAlert.astro";
import TypeChip from "../../../components/TypeChip.astro";
import { bennoTip } from "../../../lib/benno-tips";
import { getActiveLoan } from "../../../lib/data/bikes";
import { findConversation, listConversations } from "../../../lib/data/conversations";
import { BIKE_CATEGORY, getListingDetail } from "../../../lib/data/listings";
import { isSaved } from "../../../lib/data/saved";
import { firstName } from "../../../lib/data/profiles";
import { formatDate } from "../../../lib/dates";
import { formatEuro, groupThousands } from "../../../lib/euro-words";
import { fieldErrors, formError } from "../../../lib/form";
import { memberSince, placeLabel, priceLabel, relativeDate, STATUS_LABEL, TYPE_LABEL } from "../../../lib/listing-format";
import { submittedValues } from "../../../lib/submitted";
import { i18n } from "../../../i18n";

const { t, lang } = i18n(Astro.locals.lang);
const user = Astro.locals.user;
const id = Astro.params.id!;

// Owner actions and messaging post back to this page.
const removed = Astro.getActionResult(actions.listings.remove);
if (removed && !removed.error) return Astro.redirect("/app?geloescht=1#anzeigen");
const status = Astro.getActionResult(actions.listings.setStatus);
if (status && !status.error) return Astro.redirect(`/anzeigen/${id}?status=${status.data.status}`);
const saveResult = Astro.getActionResult(actions.listings.save);
if (saveResult && !saveResult.error) return Astro.redirect(`/anzeigen/${id}${saveResult.data.saved ? "?gemerkt=1" : ""}`);
const started = Astro.getActionResult(actions.messages.start);
if (started && !started.error) return Astro.redirect(`/nachrichten/${started.data.conversationId}`);

const listing = await getListingDetail(id);
if (!listing) return new Response(t("Nicht gefunden"), { status: 404 });

const own = user?.id === listing.userId;
const existingConversation = user && !own ? await findConversation(listing.id, user.id) : null;
// Inactive listings stay reachable by link (Merkliste, conversations) but say so.
const inactive = listing.status !== "aktiv";
const saved = user && !own ? await isSaved(user.id, listing.id) : false;
const isBikeOffer = listing.categorySlug === BIKE_CATEGORY && listing.type === "biete" && !!listing.bike;
const activeLoan = isBikeOffer && own ? await getActiveLoan(listing.bike!.id) : null;
const conversations = own ? await listConversations(user!.id, { listingId: listing.id }) : [];
const canMessage = !own && !inactive && !listing.lent;

const prev = await submittedValues(Astro.request, !!started?.error);
const msgErrors = fieldErrors(started);
const message = formError(started) ?? formError(status) ?? formError(removed) ?? formError(saveResult);
const confirmDelete = own && Astro.url.searchParams.has("loeschen");
const bike = listing.bike;
const loginHref = `/login?next=${encodeURIComponent(`/anzeigen/${listing.id}#kontakt`)}`;

const backHref = `/anzeigen?kategorie=${listing.categorySlug}`;
const place = placeLabel(listing, lang);
const seller = firstName(listing.seller.name) || t("Mitglied");
const sellerCount = listing.seller.activeListings === 1 ? t("1 Anzeige") : t("{n} Anzeigen", { n: listing.seller.activeListings });
const availability = listing.lent ? t("verliehen") : inactive ? t(STATUS_LABEL[listing.status]) : t("verfügbar");
const startLoanHref = isBikeOffer && !activeLoan ? `/app/loans/new?bike=${bike!.id}&listing=${listing.id}` : null;
const HEART = "M12 20s-7-4.4-7-10a4 4 0 0 1 7-2.6A4 4 0 0 1 19 10c0 5.6-7 10-7 10z";
---

<Base title={listing.title} description={listing.description.slice(0, 150)} wide mobileBar mobileDock>
  <div class="dbar" slot="before">
    <a href={backHref} class="dbar-btn" aria-label={t("Zurück zu den Anzeigen")}>
      <svg width="22" height="22" viewBox="0 0 24 24" aria-hidden="true"><path d="M15 6l-6 6 6 6"></path></svg>
    </a>
    <span class="dbar-title">{t(listing.categoryLabel)}</span>
    <button type="button" class="dbar-btn js-only" data-share aria-label={t("Teilen")}>
      <svg width="22" height="22" viewBox="0 0 24 24" aria-hidden="true"><path d="M12 3v12M7 8l5-5 5 5M5 14v6h14v-6"></path></svg>
    </button>
    <span class="dbar-btn nojs-only" aria-hidden="true"></span>
  </div>

  <nav class="crumbs small desktop-only" aria-label={t("Pfad")}>
    <a href="/">{t("Start")}</a>
    <span aria-hidden="true">›</span>
    <a href="/anzeigen">{t("Anzeigen")}</a>
    <span aria-hidden="true">›</span>
    <a href={backHref}>{t(listing.categoryLabel)}</a>
  </nav>

  <FormAlert message={message} />
  {Astro.url.searchParams.has("gemerkt") && <p class="notice" role="status">{t("Auf deiner")} <a href="/merkliste">{t("Merkliste")}</a>.</p>}
  {Astro.url.searchParams.has("status") && <p class="notice" role="status">{t("Status geändert: {status}.", { status: t(STATUS_LABEL[listing.status]) })}</p>}
  {Astro.url.searchParams.has("neu") && <p class="notice" role="status">{t("Deine Anzeige ist online.")}</p>}
  {Astro.url.searchParams.has("gespeichert") && <p class="notice" role="status">{t("Änderungen gespeichert.")}</p>}
  {
    inactive && (
      <p class="notice">
        {listing.status === "reserviert"
          ? t("Diese Anzeige ist reserviert und erscheint nicht mehr in der Suche.")
          : t("Diese Anzeige ist erledigt und erscheint nicht mehr in der Suche.")}
      </p>
    )
  }

  <div class="detail">
    <div class="detail-top">
      {
        listing.photos.length > 0 ? (
          <div class="gallery" aria-label={t("{n} Fotos", { n: listing.photos.length })}>
            <div class="gallery-frame">
              <ul class="gallery-track" data-gallery>
                {listing.photos.map((p, i) => (
                  <li id={`foto-${i + 1}`}>
                    <img
                      src={`/media/listing/${p.id}`}
                      alt={t("{title}, Foto {n} von {count}", { title: listing.title, n: i + 1, count: listing.photos.length })}
                      width="960"
                      height="720"
                      loading={i === 0 ? "eager" : "lazy"}
                    />
                  </li>
                ))}
              </ul>
              {listing.photos.length > 1 && (
                <span class="gallery-count" aria-hidden="true">
                  <span data-gallery-at>1</span> / {listing.photos.length}
                </span>
              )}
            </div>
            {listing.photos.length > 1 && (
              <nav class="gallery-thumbs" aria-label={t("Fotos")}>
                {listing.photos.map((p, i) => (
                  <a href={`#foto-${i + 1}`} aria-label={t("Foto {n}", { n: i + 1 })}>
                    <img src={`/media/listing/${p.id}`} alt="" width="80" height="60" loading="lazy" />
                  </a>
                ))}
              </nav>
            )}
          </div>
        ) : (
          <div class:list={["gallery-empty", listing.type === "suche" ? "wash-suche" : "wash-biete"]} aria-hidden="true">
            <CategoryIcon slug={listing.categorySlug} size={88} strokeWidth={1.2} />
          </div>
        )
      }

      <div class="detail-head">
        <div class="chips">
          <TypeChip type={listing.type} category={listing.categorySlug} />
          {isBikeOffer && <span class="chip chip-outline">{t("Leihe mit Vertrag")}</span>}
          {listing.lent && <span class="chip chip-ink">{t("verliehen")}</span>}
          {inactive && <span class="chip chip-outline">{t(STATUS_LABEL[listing.status])}</span>}
        </div>
        <h1>{listing.title}</h1>
        <div>
          <p class="detail-price">{priceLabel(listing.priceKind, listing.priceCents, lang)}</p>
          <p class="muted">
            {place || t("Ort nicht angegeben")} · <time datetime={listing.createdAt.toISOString()}>{relativeDate(listing.createdAt, new Date(), lang)}</time>
          </p>
        </div>
      </div>
    </div>

    <div class="detail-body">
      <dl class="facts-table">
        <div>
          <dt>{t("Art")}</dt>
          <dd>{t(TYPE_LABEL[listing.type] ?? listing.type)}</dd>
        </div>
        <div>
          <dt>{t("Kategorie")}</dt>
          <dd>{t(listing.categoryLabel)}</dd>
        </div>
        {
          isBikeOffer && bike && (
            <>
              <div>
                <dt>{t("Modell")}</dt>
                <dd>
                  {bike.make} {bike.model}
                  {bike.typeCode && ` (${bike.typeCode})`}
                </dd>
              </div>
              {bike.firstRegistration && (
                <div>
                  <dt>{t("Erstzulassung")}</dt>
                  <dd>{formatDate(bike.firstRegistration, lang).slice(3)}</dd>
                </div>
              )}
              {(bike.powerKw || bike.displacementCcm) && (
                <div>
                  <dt>{t("Leistung")}</dt>
                  <dd>
                    {[bike.powerKw ? t("{kw} kW ({ps} PS)", { kw: bike.powerKw, ps: Math.round(bike.powerKw * 1.36) }) : "", bike.displacementCcm ? `${groupThousands(bike.displacementCcm)} cm³` : ""]
                      .filter(Boolean)
                      .join(" · ")}
                  </dd>
                </div>
              )}
              <div>
                <dt>{t("Haftung")}</dt>
                <dd>{t("höchstens {amount} je Schaden", { amount: formatEuro(bike.liabilityCapEur, false) })}</dd>
              </div>
              {bike.conditions && (
                <div>
                  <dt>{t("Auflage")}</dt>
                  <dd>{bike.conditions}</dd>
                </div>
              )}
            </>
          )
        }
        <div>
          <dt>{t("Status")}</dt>
          <dd class:list={{ "is-free": !listing.lent && !inactive }}>{availability}</dd>
        </div>
      </dl>
      {
        isBikeOffer && (
          <p class="small muted">
            {t("Kostenlose Leihe nach § 598 BGB mit Leihvertrag, Übergabeprotokoll und Fotos.")} <a href="/so-gehts">{t("So geht's")}</a>
          </p>
        )
      }

      {
        listing.description && (
          <section class="detail-section" aria-labelledby="h-text">
            <h2 id="h-text">{t("Beschreibung")}</h2>
            <div class="detail-text">{listing.description}</div>
          </section>
        )
      }
    </div>

    <aside class="detail-side">
      <section class="seller-card" aria-label={t("Anbieter")}>
        <span class="avatar avatar-lg" aria-hidden="true">{seller[0]?.toUpperCase()}</span>
        <div>
          <p class="seller-name">{seller}</p>
          <p class="small muted">{memberSince(listing.seller.memberSince, lang)} · {sellerCount}</p>
        </div>
      </section>

      {
        !own && (
          <div class="side-actions" id="kontakt">
            <div class="desktop-only">
              {user ? (
                <form method="POST" action={actions.listings.save} class="save-form">
                  <input type="hidden" name="listingId" value={listing.id} />
                  <input type="hidden" name="saved" value={saved ? "0" : "1"} />
                  <button type="submit" class:list={["btn", "btn-heart", { on: saved }]} aria-pressed={saved ? "true" : "false"}>
                    <svg width="20" height="20" viewBox="0 0 24 24" aria-hidden="true"><path d={HEART} /></svg>
                    {saved ? t("Gemerkt") : t("Merken")}
                  </button>
                </form>
              ) : (
                <a class="btn btn-heart" href={loginHref}>
                  <svg width="20" height="20" viewBox="0 0 24 24" aria-hidden="true"><path d={HEART} /></svg>
                  {t("Merken")}
                </a>
              )}
            </div>

            {existingConversation ? (
              <a class="btn btn-primary btn-block desktop-only" href={`/nachrichten/${existingConversation}`}>
                {t("Zur Unterhaltung")}
              </a>
            ) : !canMessage ? (
              <p class="small muted">{listing.lent ? t("Das Motorrad ist gerade verliehen. Schau später nochmal vorbei.") : t("Für diese Anzeige sind keine neuen Nachrichten möglich.")}</p>
            ) : user ? (
              <form method="POST" action={`${actions.messages.start}`} class="stack msg-form" novalidate>
                <input type="hidden" name="listingId" value={listing.id} />
                <Field
                  label={t("Nachricht schreiben")}
                  name="body"
                  multiline
                  required
                  maxlength={4000}
                  value={prev?.body ?? ""}
                  error={msgErrors.body}
                  placeholder={listing.type === "biete" ? t("Hallo, ist das noch zu haben? Wann würde es passen?") : t("Hallo, ich kann dir helfen.")}
                />
                <button type="submit" class="btn-primary btn-block">
                  {t("Nachricht senden")}
                </button>
              </form>
            ) : (
              <a class="btn btn-primary btn-block desktop-only" href={loginHref}>
                {t("Nachricht schreiben")}
              </a>
            )}
            {!user && <p class="small muted">{t("Zum Schreiben bitte anmelden. Kostenlos.")}</p>}
          </div>
        )
      }

      {
        own && (
          <section class="panel owner" id="verwalten" aria-labelledby="h-owner">
            <h2 id="h-owner">{t("Deine Anzeige")}</h2>
            <div class="actions">
              <a class="btn btn-primary" href={`/anzeigen/${listing.id}/bearbeiten`}>
                {t("Bearbeiten")}
              </a>
            </div>
            <form method="POST" action={actions.listings.setStatus} class="status-form">
              <input type="hidden" name="id" value={listing.id} />
              <p class="small muted">{t("Status")}</p>
              <div class="seg seg-3">
                {(["aktiv", "reserviert", "erledigt"] as const).map((st) => (
                  <button type="submit" name="status" value={st} class:list={{ on: listing.status === st }} aria-pressed={listing.status === st ? "true" : "false"}>
                    {t(STATUS_LABEL[st])}
                  </button>
                ))}
              </div>
            </form>

            {isBikeOffer &&
              (activeLoan ? (
                <p class="small">
                  {t("Gerade verliehen an {name}.", { name: activeLoan.borrowerName })} <a href={`/app/loans/${activeLoan.id}`}>{t("Zum Vertrag")}</a>
                </p>
              ) : (
                <a class="btn btn-block" href={startLoanHref!}>
                  {t("Leihvertrag starten")}
                </a>
              ))}

            {conversations.length > 0 && (
              <div class="stack">
                <p class="small muted">{t("Nachrichten zu dieser Anzeige")}</p>
                <ul class="list">
                  {conversations.map((c) => (
                    <li class:list={["item", { unread: c.unread > 0 }]}>
                      <div class="item-head">
                        <a class="item-title" href={`/nachrichten/${c.id}`}>
                          {c.other.name}
                        </a>
                        {c.unread > 0 && <span class="count count-hot">{t("{n} neu", { n: c.unread })}</span>}
                      </div>
                      {isBikeOffer && !activeLoan && (
                        <a class="btn-link" href={`/app/loans/new?bike=${bike!.id}&listing=${listing.id}&conversation=${c.id}`}>
                          {t("Leihvertrag mit {name} starten", { name: firstName(c.other.name) })}
                        </a>
                      )}
                    </li>
                  ))}
                </ul>
              </div>
            )}

            <div id="loeschen">
              {confirmDelete ? (
                <form method="POST" action={actions.listings.remove} class="confirm-box">
                  <input type="hidden" name="id" value={listing.id} />
                  <input type="hidden" name="confirm" value="ja" />
                  <p>
                    <strong>{t("Anzeige wirklich löschen?")}</strong> {t("Fotos und Nachrichten dazu werden mit gelöscht.")}
                  </p>
                  <div class="actions">
                    <button type="submit" class="btn-danger">
                      {t("Ja, löschen")}
                    </button>
                    <a class="btn" href={`/anzeigen/${listing.id}`}>
                      {t("Abbrechen")}
                    </a>
                  </div>
                </form>
              ) : (
                <a class="btn-link danger-link" href={`/anzeigen/${listing.id}?loeschen=1#loeschen`}>
                  {t("Anzeige löschen")}
                </a>
              )}
            </div>
          </section>
        )
      }
    </aside>

    <div class="detail-extra">
      <aside class="tip-box" aria-labelledby="h-tip">
        <BennoMark size={48} bg="white" />
        <div>
          <p id="h-tip" class="tip-title">{t("Benno-Tipp")}</p>
          <p>{t(bennoTip(listing.categorySlug))}</p>
        </div>
      </aside>

      {
        place && (
          <section class="detail-section" aria-labelledby="h-where">
            <h2 id="h-where">{t("Wo")}</h2>
            <div class="where-box">
              <svg width="28" height="28" viewBox="0 0 24 24" aria-hidden="true"><path d="M12 21s-6-5.6-6-11a6 6 0 0 1 12 0c0 5.4-6 11-6 11z"></path><circle cx="12" cy="10" r="2.5"></circle></svg>
              <span>{t("Ungefährer Standort")} · {place}</span>
            </div>
          </section>
        )
      }

      {!own && <a class="report-link" href="/impressum">{t("Anzeige melden")}</a>}
    </div>
  </div>

  <div class="mbar" slot="after">
    {
      own ? (
        <>
          <a class="btn btn-icon" href={`/anzeigen/${listing.id}/bearbeiten`} aria-label={t("Bearbeiten")}>
            <svg width="20" height="20" viewBox="0 0 24 24" aria-hidden="true"><path d="M4 20h4L19 9l-4-4L4 16zM14 6l4 4"></path></svg>
          </a>
          <a class:list={["btn", { "mbar-grow": !startLoanHref }]} href="#verwalten">
            {t("Status")}
          </a>
          {startLoanHref && (
            <a class="btn btn-primary mbar-grow" href={startLoanHref}>
              {t("Leihvertrag starten")}
            </a>
          )}
        </>
      ) : (
        <>
          {user ? (
            <form method="POST" action={actions.listings.save}>
              <input type="hidden" name="listingId" value={listing.id} />
              <input type="hidden" name="saved" value={saved ? "0" : "1"} />
              <button type="submit" class:list={["btn", "btn-icon", "btn-heart", { on: saved }]} aria-pressed={saved ? "true" : "false"} aria-label={t("Merken")}>
                <svg width="22" height="22" viewBox="0 0 24 24" aria-hidden="true"><path d={HEART} /></svg>
              </button>
            </form>
          ) : (
            <a class="btn btn-icon btn-heart" href={loginHref} aria-label={t("Merken")}>
              <svg width="22" height="22" viewBox="0 0 24 24" aria-hidden="true"><path d={HEART} /></svg>
            </a>
          )}
          {existingConversation ? (
            <a class="btn btn-primary mbar-grow" href={`/nachrichten/${existingConversation}`}>
              {t("Zur Unterhaltung")}
            </a>
          ) : !canMessage ? (
            <span class="mbar-note">{listing.lent ? t("verliehen") : t(STATUS_LABEL[listing.status])}</span>
          ) : (
            <a class="btn btn-primary mbar-grow" href={user ? "#kontakt" : loginHref}>
              {t("Nachricht schreiben")}
            </a>
          )}
        </>
      )
    }
  </div>
</Base>

<script>
  import { ct } from "../../../i18n/client";

  // "1 / n" follows the swipe.
  const track = document.querySelector<HTMLElement>("[data-gallery]");
  const at = document.querySelector<HTMLElement>("[data-gallery-at]");
  if (track && at) {
    track.addEventListener(
      "scroll",
      () => {
        at.textContent = String(Math.round(track.scrollLeft / track.clientWidth) + 1);
      },
      { passive: true },
    );
  }

  // Share: the system sheet where there is one, otherwise copy the link.
  const share = document.querySelector<HTMLButtonElement>("[data-share]");
  share?.addEventListener("click", async () => {
    const url = location.href.split("#")[0];
    if (navigator.share) {
      await navigator.share({ title: document.title, url }).catch(() => {});
    } else {
      await navigator.clipboard?.writeText(url).catch(() => {});
      share.setAttribute("aria-label", ct("Link kopiert"));
      share.classList.add("done");
    }
  });
</script>
