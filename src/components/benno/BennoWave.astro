---
// Benno waving, no wrench: tips, greetings, empty states. Benno.astro without the tail crosshatch, wrench,
// right arm, neckerchief knot, highlights and tooth line, with one arm raised and one lowered.
interface Props {
  size?: number;
  /** Accessible name. Empty: decorative (aria-hidden). */
  label?: string;
  class?: string;
}

const { size = 120, label = "", class: cls } = Astro.props;
const a11y = label ? { role: "img" as const, "aria-label": label } : { "aria-hidden": "true" as const };
---

