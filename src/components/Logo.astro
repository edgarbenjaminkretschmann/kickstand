---
// Benno's head and the wordmark "kickstand".
import BennoMark from "./benno/BennoMark.astro";
import { i18n } from "../i18n";

interface Props {
  href?: string;
}

const { href = "/" } = Astro.props;
const { t } = i18n(Astro.locals.lang);
---

<a href={href} class="logo" aria-label={t("Kickstand. Zur Startseite")}>
  <BennoMark size={40} />
  <span class="logo-word" aria-hidden="true">kickstand</span>
</a>

<style>
  .logo {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    color: var(--ink);
    text-decoration: none;
    min-height: var(--tap);
    flex: none;
  }
  .logo:hover {
    color: var(--ink);
  }
  .logo-word {
    font-family: var(--display);
    font-weight: 800;
    font-size: 24px;
    line-height: 1;
    letter-spacing: -0.01em;
  }
</style>
