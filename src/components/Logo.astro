---
// "Kickstand" in Mr Dafoe inside the sky oval. Design A (the look is borrowed from vlogato.com).
interface Props {
  href?: string;
}

const { href = "/" } = Astro.props;
---

<a href={href} class="logo" aria-label="Kickstand. Zur Startseite">
  <span class="logo-oval" aria-hidden="true">Kickstand</span>
</a>

<style>
  .logo {
    display: inline-flex;
    align-items: center;
    color: var(--ink);
    text-decoration: none;
    min-height: var(--tap);
  }
  .logo-oval {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 132px;
    height: 56px;
    border-radius: 50%;
    background: var(--sky);
    font-family: var(--script);
    font-size: 34px;
    line-height: 1;
    color: var(--ink);
    flex: none;
  }
  @media (max-width: 560px) {
    .logo-oval {
      width: 104px;
      height: 44px;
      font-size: 27px;
    }
  }
</style>
