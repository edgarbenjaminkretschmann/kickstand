---
import { actions } from "astro:actions";
import Logo from "../components/Logo.astro";
import { CATEGORIES } from "../db/categories";
import { i18n, LANG_NAMES, LANGS } from "../i18n";
import clientKeys from "../i18n/client-keys.json";
import { unreadTotal } from "../lib/data/conversations";
import "../styles/global.css";

interface Props {
  title?: string;
  description?: string;
  /** Page has its own fixed bottom bar (loan wizard, return): hides the tab bar and footer. */
  dock?: boolean;
  /** Keeps the footer on a dock page (public pages need Impressum and the language switch). */
  dockFooter?: boolean;
  /** Fixed bottom bar on phones only (listing detail): hides the tab bar, keeps the footer. */
  mobileDock?: boolean;
  /** The page draws its own top bar on phones (listing detail): hides the site header there. */
  mobileBar?: boolean;
  /** Wider content column (search, detail). */
  wide?: boolean;
  /** Full-bleed page that lays out its own sections (landing). */
  bare?: boolean;
}

const { t, lang, tag } = i18n(Astro.locals.lang);
const {
  title,
  description = t("Motorräder kostenlos leihen, Garagen, Werkzeug und Hilfe unter Motorradfahrern. Mit Leihvertrag aus dem Handy."),
  dock = false,
  dockFooter = false,
  mobileDock = false,
  mobileBar = false,
  wide = false,
  bare = false,
} = Astro.props;
const user = Astro.locals.user;
const path = Astro.url.pathname;
const pageTitle = title ? `${title} · Kickstand` : `Kickstand · ${t("Motorräder teilen, Garagen teilen")}`;
// The same page in every language. German links go through /de/…, which redirects to the plain URL, so the
// link rewriter (src/i18n/links.ts) does not prefix them with the current language.
const here = path + Astro.url.search;
const altHref = (l: (typeof LANGS)[number]) => (l === "de" ? `/de${here === "/" ? "" : here}` : `/${l}${here === "/" ? "" : here}`);
const site = Astro.site ?? Astro.url;
// Strings browser scripts need (collected from their ct calls), in this page's language. "<" is escaped so
// the JSON cannot close the script element.
const clientDict = lang === "de" ? null : JSON.stringify(Object.fromEntries(clientKeys.map((k) => [k, t(k)]))).replace(/</g, "\\u003c");
const unread = user ? await unreadTotal(user.id) : 0;
const initial = (user?.name.trim()[0] ?? "?").toUpperCase();

const is = (prefix: string) => path === prefix || path.startsWith(`${prefix}/`);
const current = (on: boolean) => (on ? "page" : undefined);
const onSearch = is("/anzeigen") && !is("/anzeigen/neu");

// Search and member pages get the compact search in the header and the member nav; the rest the public nav.
const appHeader = is("/anzeigen") || is("/app") || is("/nachrichten") || is("/merkliste") || is("/profil");
const params = Astro.url.searchParams;
const searchQ = path === "/anzeigen" ? (params.get("q") ?? "") : "";
const searchOrt = path === "/anzeigen" ? (params.get("ort") ?? "") : "";
// On the results page, the header search keeps the filters from the side card (and the other way round).
const carry = path === "/anzeigen" ? [...params].filter(([k]) => !["q", "ort", "seite"].includes(k)) : [];
const loginHref = `/login${path === "/" || path === "/login" ? "" : `?next=${encodeURIComponent(path + Astro.url.search)}`}`;

const tabs = [
  { href: "/anzeigen", label: t("Suchen"), icon: "search", on: onSearch },
  { href: "/merkliste", label: t("Merkliste"), icon: "heart", on: is("/merkliste") },
  { href: "/anzeigen/neu", label: t("Aufgeben"), icon: "plus", on: is("/anzeigen/neu") },
  { href: "/nachrichten", label: t("Nachrichten"), icon: "chat", on: is("/nachrichten"), badge: unread },
  { href: "/app", label: t("Mein Bereich"), icon: "user", on: is("/app") || is("/profil") },
];
const HEART = "M12 20s-7-4.4-7-10a4 4 0 0 1 7-2.6A4 4 0 0 1 19 10c0 5.6-7 10-7 10z";
---

<!doctype html>
<html lang={tag.slice(0, 2)}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <meta name="description" content={description} />
    <meta name="color-scheme" content="light" />
    <meta name="theme-color" content="#ffffff" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Barlow+Semi+Condensed:wght@600;700;800&family=Inter:wght@400;500;600;700&display=swap"
    />
    <title>{pageTitle}</title>
    {LANGS.map((l) => <link rel="alternate" hreflang={l} href={new URL(l === "de" ? here : `/${l}${here === "/" ? "" : here}`, site).href} />)}
    <script is:inline>document.documentElement.classList.add("js");</script>
    {clientDict && <script type="application/json" id="i18n-client" set:html={clientDict} />}
  </head>
  <body
    class:list={{
      "has-dock": dock,
      "has-tabs": !dock && !mobileDock,
      "has-dock-footer": dock && dockFooter,
      "has-mobile-dock": mobileDock,
    }}
  >
    <a href="#main" class="skip">{t("Zum Inhalt")}</a>
    <header class:list={["site-header", { "head-app": appHeader, "head-mobile-off": mobileBar }]}>
      <div class="bar">
        <Logo />
        {
          appHeader && (
            <form method="GET" action="/anzeigen" class="hsearch" role="search">
              {carry.map(([k, v]) => (
                <input type="hidden" name={k} value={v} />
              ))}
              <label class="hs-q">
                <svg width="20" height="20" viewBox="0 0 24 24" aria-hidden="true">
                  <circle cx="11" cy="11" r="7" />
                  <path d="M20 20l-3.5-3.5" />
                </svg>
                <span class="visually-hidden">{t("Suchbegriff")}</span>
                <input type="search" name="q" value={searchQ} placeholder={t("Was suchst du?")} enterkeyhint="search" />
              </label>
              <label class="hs-ort">
                <span class="visually-hidden">{t("PLZ oder Ort")}</span>
                <input type="search" name="ort" value={searchOrt} placeholder={t("PLZ oder Ort")} autocomplete="address-level2" enterkeyhint="search" />
              </label>
              <button type="submit" class="btn-primary">
                {t("Finden")}
              </button>
            </form>
          )
        }
        <nav class="main-nav desktop-only" aria-label={t("Hauptnavigation")}>
          {
            appHeader ? (
              <>
                <a href="/anzeigen" class="nav-link" aria-current={current(onSearch)}>
                  {t("Anzeigen")}
                </a>
                {user && (
                  <a href="/nachrichten" class="nav-link" aria-current={current(is("/nachrichten"))}>
                    {t("Nachrichten")}
                    {unread > 0 && (
                      <span class="count count-hot" aria-label={t("{n} ungelesen", { n: unread })}>
                        {unread}
                      </span>
                    )}
                  </a>
                )}
              </>
            ) : (
              <>
                <a href="/anzeigen" class="nav-link" aria-current={current(onSearch)}>
                  {t("Anzeigen")}
                </a>
                <a href="/leihvertrag" class="nav-link" aria-current={current(is("/leihvertrag"))}>
                  {t("Leihvertrag")}
                </a>
                <a href="/so-gehts" class="nav-link" aria-current={current(is("/so-gehts"))}>
                  {t("So geht's")}
                </a>
                <a href="/#sicherheit" class="nav-link">
                  {t("Sicherheit")}
                </a>
              </>
            )
          }
        </nav>
        <div class="head-actions">
          <a href="/merkliste" class="head-icon desktop-only" aria-label={t("Merkliste")} aria-current={current(is("/merkliste"))}>
            <svg width="22" height="22" viewBox="0 0 24 24" aria-hidden="true"><path d={HEART} /></svg>
          </a>
          {
            user ? (
              <details class="menu">
                <summary aria-label={t("Menü für {name}", { name: user.name })}>
                  <span class="avatar" aria-hidden="true">
                    {initial}
                  </span>
                  {unread > 0 && <span class="dot mobile-only" aria-hidden="true" />}
                </summary>
                <div class="menu-pop">
                  <p class="menu-name">{user.name}</p>
                  <a href="/app">{t("Mein Bereich")}</a>
                  <a href="/app#anzeigen">{t("Meine Anzeigen")}</a>
                  <a href="/nachrichten">{t("Nachrichten")}</a>
                  <a href="/merkliste">{t("Merkliste")}</a>
                  <a href="/profil">{t("Profil")}</a>
                  <form method="POST" action={"/" + actions.auth.logout}>
                    <button type="submit">{t("Abmelden")}</button>
                  </form>
                </div>
              </details>
            ) : (
              <a href={loginHref} class="btn btn-outline btn-small">
                {t("Anmelden")}
              </a>
            )
          }
          <a href="/anzeigen/neu" class="btn btn-primary btn-small desktop-only">
            <svg width="18" height="18" viewBox="0 0 24 24" aria-hidden="true"><path d="M12 5v14M5 12h14" /></svg>
            {t("Anzeige aufgeben")}
          </a>
        </div>
      </div>
    </header>
    <slot name="before" />

    {
      bare ? (
        <main id="main" class="bare">
          <slot />
        </main>
      ) : (
        <main id="main" class:list={["wrap", "page", { wide }]}>
          <slot />
        </main>
      )
    }
    <slot name="after" />

    {
      (!dock || dockFooter) && (
        <footer class="site-footer">
          <div class="foot">
            <div class="foot-brand">
              <p class="foot-word">kickstand</p>
              <p>{t("Der Marktplatz von Motorradfahrern für Motorradfahrer.")}</p>
            </div>
            <nav class="foot-col" aria-label="Kickstand">
              <p class="foot-head">Kickstand</p>
              <a href="/so-gehts">{t("So geht's")}</a>
              <a href="/#sicherheit">{t("Sicherheit")}</a>
              <a href="/leihvertrag">{t("Leihvertrag")}</a>
              <a href="/touren">{t("Edgars Touren")}</a>
            </nav>
            <nav class="foot-col" aria-label={t("Kategorien")}>
              <p class="foot-head">{t("Kategorien")}</p>
              {CATEGORIES.map((c) => <a href={`/anzeigen?kategorie=${c.slug}`}>{t(c.label)}</a>)}
            </nav>
            <nav class="foot-col" aria-label={t("Rechtliches")}>
              <p class="foot-head">{t("Rechtliches")}</p>
              <a href="/impressum">{t("Impressum")}</a>
              <a href="/datenschutz">{t("Datenschutz")}</a>
            </nav>
          </div>
          <div class="foot-base">
            <span>{t("Kickstand · ein Projekt von Edgar Kretschmann")}</span>
            <nav class="lang-switch" aria-label={t("Sprache")}>
              {LANGS.map((l) => (
                <a href={altHref(l)} hreflang={l} lang={l} aria-current={l === lang ? "true" : undefined}>
                  {LANG_NAMES[l]}
                </a>
              ))}
            </nav>
          </div>
        </footer>
      )
    }

    {
      !dock && !mobileDock && (
        <nav class="tabbar" aria-label={t("Schnellzugriff")}>
          {tabs.map((tab) => (
            <a href={tab.href} aria-current={current(tab.on)} class:list={{ "tab-add": tab.icon === "plus" }}>
              <span class="tab-icon" aria-hidden="true">
                {tab.icon === "search" && (
                  <svg viewBox="0 0 24 24">
                    <circle cx="11" cy="11" r="6.5" />
                    <path d="M16 16l4.5 4.5" />
                  </svg>
                )}
                {tab.icon === "heart" && (
                  <svg viewBox="0 0 24 24">
                    <path d={HEART} />
                  </svg>
                )}
                {tab.icon === "plus" && (
                  <svg viewBox="0 0 24 24">
                    <path d="M12 6v12M6 12h12" />
                  </svg>
                )}
                {tab.icon === "chat" && (
                  <svg viewBox="0 0 24 24">
                    <path d="M4 5.5h16v10H9l-4 3.5v-3.5H4z" />
                  </svg>
                )}
                {tab.icon === "user" && (
                  <svg viewBox="0 0 24 24">
                    <circle cx="12" cy="8.5" r="3.8" />
                    <path d="M4.5 20c1.2-3.7 4-5.5 7.5-5.5s6.3 1.8 7.5 5.5" />
                  </svg>
                )}
                {tab.badge ? <span class="tab-badge">{tab.badge > 9 ? "9+" : tab.badge}</span> : null}
              </span>
              <span class="tab-label">{tab.label}</span>
            </a>
          ))}
        </nav>
      )
    }

    <script>
      import "../scripts/inputs";
    </script>
  </body>
</html>
