# Required in production. Any long random string (e.g. `openssl rand -hex 32`).
BETTER_AUTH_SECRET=change-me-to-a-long-random-string
# Public URL of the app. Needed at build time (Astro origin check) and used by Better Auth.
SITE_URL=http://localhost:4321
BETTER_AUTH_URL=http://localhost:4321
# SQLite file locally; any libSQL URL works (Turso: libsql://<db>.turso.io plus DATABASE_AUTH_TOKEN).
DATABASE_URL=file:./data/kickstand.db
DATABASE_AUTH_TOKEN=
# Google login. Leave empty to hide the "Mit Google anmelden" button. See README.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Where uploaded photos go. Defaults to ./uploads
UPLOAD_DIR=./uploads

# Cloudflare Workers: these go into wrangler.jsonc (vars) and `wrangler secret put` instead of .env.
# For `npm run preview:cf`, put them into .dev.vars (git-ignored).
