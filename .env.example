# Local overrides for `npm run dev` (copy to .env). Everything is optional: without a .env the app uses
# ./data/kickstand.db, photos in ./uploads and a dev-only session secret.
#
# Production runs on Cloudflare Workers: plain vars are in wrangler.jsonc → vars, secrets are set with
# `npx wrangler secret put <NAME>`. For `npm run preview` see .dev.vars.example.

# SQLite file locally; any libSQL URL works (Turso: libsql://<db>-<org>.turso.io plus DATABASE_AUTH_TOKEN).
DATABASE_URL=file:./data/kickstand.db
DATABASE_AUTH_TOKEN=
# Any long random string (`openssl rand -hex 32`). Required in production builds.
BETTER_AUTH_SECRET=
# Public URL of the app. Read at build time (Astro origin check) and by Better Auth.
SITE_URL=http://localhost:4321
BETTER_AUTH_URL=
# Google login. Leave empty to hide the "Mit Google anmelden" button. See README.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Show the demo accounts on /login outside dev ("true" / "false"). Dev always shows them.
SHOW_DEMO_LOGINS=
# PostHog project token (phc_…) and host. Leave empty to load no analytics (the default locally).
POSTHOG_KEY=
POSTHOG_HOST=
# Brevo API key for password-reset mails, and the sender (a verified Brevo sender). Without a key, dev prints
# the mail (with the reset link) to the console.
BREVO_API_KEY=
MAIL_FROM=hello@kickstand.top
MAIL_FROM_NAME=Kickstand
# Where uploaded photos go on Node. Defaults to ./uploads
UPLOAD_DIR=./uploads

# Turso credentials for `npm run db:migrate -- --remote` / `db:seed -- --remote` go into .env.turso
# (git-ignored), not here:
#   DATABASE_URL=libsql://kickstand-kickstand.aws-eu-west-1.turso.io
#   DATABASE_AUTH_TOKEN=<read & write token>
